{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "es2017",

    "outDir": "lib",
    "rootDir": "src",

    "sourceMap": true,

    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,

    "esModuleInterop": true
  },

  "compileOnSave": true,

  "include": [
    "src"
  ]
}